{
    "name": "phptailors/workflows",
    "description": "Reusable Workflows",
    "type": "library",
    "authors": [
        {
            "name": "Paweł Tomulik",
            "email": "pawel@tomulik.pl"
        }
    ],
    "support": {
        "issues": "https://github.com/phptailors/workflows/issues",
        "source": "https://github.com/phptailors/workflows"
    },
    "require": {
        "php": ">=8.2",
        "symfony/console": ">= 7.2",
        "symfony/process": ">= 7.2",
        "symfony/property-access": ">= 7.2",
        "symfony/config": ">=7.2",
        "composer/composer": "^2.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Tailors\\Console\\Workflows\\": "src/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tailors\\Console\\Workflows\\": "tests/src/"
        }
    },
    "bin": [
        "bin/phptailors-workflows"
    ],
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": false,
            "target-directory": "vendor-bin"
        },
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
